<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read-only network-state access so the app can refresh the moment
         connectivity returns (ConnectivityObserver), mirroring iOS NWPathMonitor. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase N J09 leave-by reminders: exact alarms so "leave now" fires on time.
         Revocable on Android 13+; the scheduler checks canScheduleExactAlarms() and
         falls back to an inexact alarm when the user has not granted it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 3.0.2 nearby next-train notifications: geofences around the nearest
         stations need "Allow all the time" location on Android 10+. Opt-in from
         Settings only; location never leaves the device. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Airport tab trips and 3.0.2 calendar leave-by reminders: events are read
         on device only. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:name=".SyrmosApplication"
        android:allowBackup="true"
        android:label="Syrmos"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Syrmos">
        <receiver
            android:name=".RailPulseNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name=".LeaveByReminderReceiver"
            android:exported="false" />
        <!-- 3.0.2: nearby next-train geofence transitions and calendar leave-by alarms. -->
        <receiver
            android:name=".proactive.GeofenceBroadcastReceiver"
            android:exported="false" />
        <receiver
            android:name=".proactive.CalendarLeaveByReceiver"
            android:exported="false" />
        <!-- 3.0.2: "Announcements from Syrmos" by Firebase Cloud Messaging.
             FirebaseApp is initialised manually (no google-services.json). -->
        <service
            android:name=".push.SyrmosMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="syrmos_broadcasts" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Syrmos.Launch"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the Settings → STASY map row hand the cached PDF off to
             the user's chosen PDF viewer via Intent.ACTION_VIEW. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Widget configuration screen (Edit widget): pick nearest vs a pinned
             station and an optional line filter. Launched when adding a widget
             and, on Android 12+, from the widget's reconfigure affordance. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Syrmos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Compose Glance widgets (1.2 "Widgets Everywhere"). Each renders the
             SharedPreferences snapshot written by SnapshotWorker every ~30 min
             (and on app resume), with a bundled offline fallback. -->
        <receiver
            android:name=".widget.NextTrainGlanceReceiver"
            android:exported="true"
            android:label="@string/widget_next_train_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glance_next_train_info" />
        </receiver>
        <receiver
            android:name=".widget.LiveDeparturesGlanceReceiver"
            android:exported="true"
            android:label="@string/widget_live_departures_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glance_live_departures_info" />
        </receiver>
        <receiver
            android:name=".widget.LineStatusGlanceReceiver"
            android:exported="true"
            android:label="@string/widget_line_status_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glance_line_status_info" />
        </receiver>
        <receiver
            android:name=".widget.NearMeGlanceReceiver"
            android:exported="true"
            android:label="@string/widget_near_me_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glance_near_me_info" />
        </receiver>
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/actions" />
    </application>
</manifest>
