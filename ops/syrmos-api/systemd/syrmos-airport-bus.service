[Unit]
Description=Syrmos unified airport bus watcher (Athens OASA + Thessaloniki OSETH)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peterdsp
Environment=PIPELINE_ROOT=/home/peterdsp/syrmos-api
ExecStart=/usr/bin/python3 /home/peterdsp/syrmos-api/scripts/airport-bus-watcher.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=syrmos-airport-bus

[Install]
WantedBy=multi-user.target
