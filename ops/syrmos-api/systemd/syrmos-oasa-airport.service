[Unit]
Description=Syrmos OASA airport express bus watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peterdsp
Environment=PIPELINE_ROOT=/home/peterdsp/syrmos-api
ExecStart=/usr/bin/python3 /home/peterdsp/syrmos-api/scripts/oasa-airport-bus-watcher.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=syrmos-oasa-airport

[Install]
WantedBy=multi-user.target
