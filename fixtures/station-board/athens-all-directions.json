        "coverage": []
      },
      "expect": {
        "partial": false,
        "timedGroupCount": 3,
        "groups": [
          { "id": "metro||M3|city|doukissis plakentias", "destination": "Doukissis Plakentias", "nextMinutes": 3, "times": [3], "total": 1, "coverage": "loaded" },
          { "id": "metro||M3|city|dimotiko theatro", "destination": "Dimotiko Theatro", "nextMinutes": 5, "times": [5], "total": 1, "coverage": "loaded" },
          { "id": "metro||M3|airport|airport", "destination": "Airport", "nextMinutes": 9, "times": [9], "total": 1, "coverage": "loaded" }
        ]
      }
    },
    {
      "id": "duplicates_collapse_same_minute_trains_survive",
      "note": "Acceptance 6. Two records for one trip collapse and the higher-confidence source wins the time. Two different trips leaving in the same minute toward different destinations both survive.",
      "input": {
        "windowMinutes": 720,
        "maxTimesPerGroup": 3,
        "departures": [
          { "stopId": "A1_ATH", "areaId": "rail", "lineId": "A1", "destination": "Airport", "tripId": "A1-2050", "serviceDate": "2026-09-30", "time": "12:12", "absoluteMinutes": 12, "minutesAway": 12, "source": "scheduled", "sourceLabel": "Scheduled", "boardsHere": true },
          { "stopId": "A1_ATH", "areaId": "rail", "lineId": "A1", "destination": "Airport", "tripId": "A1-2050", "serviceDate": "2026-09-30", "time": "12:15", "absoluteMinutes": 15, "minutesAway": 15, "source": "live", "sourceLabel": "Live", "scheduledMinutes": 12, "observedAt": 1000, "boardsHere": true },
          { "stopId": "A3_ATH", "areaId": "rail", "lineId": "A3", "destination": "Chalkida", "tripId": "A3-1360", "serviceDate": "2026-09-30", "time": "12:20", "absoluteMinutes": 20, "minutesAway": 20, "source": "scheduled", "boardsHere": true },
