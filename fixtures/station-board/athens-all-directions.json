          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "M2-E-2", "serviceDate": "2026-09-30", "time": "12:10", "absoluteMinutes": 10, "minutesAway": 10, "source": "estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "M2-E-3", "serviceDate": "2026-09-30", "time": "12:20", "absoluteMinutes": 20, "minutesAway": 20, "source": "estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Anthoupoli", "tripId": "M2-A-1", "serviceDate": "2026-09-30", "time": "12:01", "absoluteMinutes": 1, "minutesAway": 1, "source": "estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Anthoupoli", "tripId": "M2-A-2", "serviceDate": "2026-09-30", "time": "12:11", "absoluteMinutes": 11, "minutesAway": 11, "source": "estimated", "boardsHere": true },
          { "stopId": "A3_ATH", "areaId": "rail", "lineId": "A3", "destination": "Chalkida", "tripId": "A3-1360", "serviceDate": "2026-09-30", "time": "12:08", "absoluteMinutes": 8, "minutesAway": 8, "source": "scheduled", "trainNo": "1360", "boardsHere": true },
          { "stopId": "A1_ATH", "areaId": "rail", "lineId": "A1", "destination": "Airport", "tripId": "A1-2050", "serviceDate": "2026-09-30", "time": "12:12", "absoluteMinutes": 12, "minutesAway": 12, "source": "scheduled", "boardsHere": true },
          { "stopId": "GR_ATH", "areaId": "rail", "lineId": "IC1", "destination": "Thessaloniki", "tripId": "IC-54", "serviceDate": "2026-09-30", "time": "12:25", "absoluteMinutes": 25, "minutesAway": 25, "source": "scheduled", "trainNo": "54", "boardsHere": true },
          { "stopId": "A4_ATH", "areaId": "rail", "lineId": "A4", "destination": "Kiato", "tripId": "A4-1512", "serviceDate": "2026-09-30", "time": "12:40", "absoluteMinutes": 40, "minutesAway": 40, "source": "scheduled", "boardsHere": true },
          { "stopId": "GR_ATH", "areaId": "rail", "lineId": "RG1", "destination": "Leianokladi", "tripId": "RG-884", "serviceDate": "2026-09-30", "time": "12:50", "absoluteMinutes": 50, "minutesAway": 50, "source": "scheduled", "boardsHere": true }
        ],
        "coverage": []
      },
      "expect": {
        "partial": false,
        "timedGroupCount": 7,
        "groups": [
          { "id": "metro||M2||elliniko", "destination": "Elliniko", "lineId": "M2", "stopId": "M2_STA", "nextMinutes": 0, "times": [0, 10, 20], "total": 3, "coverage": "loaded" },
          { "id": "metro||M2||anthoupoli", "destination": "Anthoupoli", "lineId": "M2", "stopId": "M2_STA", "nextMinutes": 1, "times": [1, 11], "total": 2, "coverage": "loaded" },
          { "id": "rail||A3||chalkida", "destination": "Chalkida", "lineId": "A3", "stopId": "A3_ATH", "nextMinutes": 8, "times": [8], "total": 1, "coverage": "loaded" },
          { "id": "rail||A1||airport", "destination": "Airport", "lineId": "A1", "stopId": "A1_ATH", "nextMinutes": 12, "times": [12], "total": 1, "coverage": "loaded" },
          { "id": "rail||IC1||thessaloniki", "destination": "Thessaloniki", "lineId": "IC1", "stopId": "GR_ATH", "nextMinutes": 25, "times": [25], "total": 1, "coverage": "loaded" },
          { "id": "rail||A4||kiato", "destination": "Kiato", "lineId": "A4", "stopId": "A4_ATH", "nextMinutes": 40, "times": [40], "total": 1, "coverage": "loaded" },
          { "id": "rail||RG1||leianokladi", "destination": "Leianokladi", "lineId": "RG1", "stopId": "GR_ATH", "nextMinutes": 50, "times": [50], "total": 1, "coverage": "loaded" }
        ]
      }
    },
    {
      "id": "frequent_line_cannot_crowd_out_a_rare_one",
