          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "F6", "time": "12:15", "absoluteMinutes": 15, "minutesAway": 15, "source": "estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "F7", "time": "12:18", "absoluteMinutes": 18, "minutesAway": 18, "source": "estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "F8", "time": "12:21", "absoluteMinutes": 21, "minutesAway": 21, "source": "estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "F9", "time": "12:24", "absoluteMinutes": 24, "minutesAway": 24, "source": "estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "F10", "time": "12:27", "absoluteMinutes": 27, "minutesAway": 27, "source": "estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "F11", "time": "12:30", "absoluteMinutes": 30, "minutesAway": 30, "source": "estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "F12", "time": "12:33", "absoluteMinutes": 33, "minutesAway": 33, "source": "estimated", "boardsHere": true },
          { "stopId": "GR_ATH", "areaId": "rail", "lineId": "RG1", "destination": "Leianokladi", "tripId": "RG-884", "time": "12:55", "absoluteMinutes": 55, "minutesAway": 55, "source": "scheduled", "boardsHere": true }
        ],
        "coverage": []
      },
      "expect": {
        "partial": false,
        "timedGroupCount": 2,
        "groups": [
          { "id": "metro||M2||elliniko", "destination": "Elliniko", "lineId": "M2", "stopId": "M2_STA", "nextMinutes": 0, "times": [0, 3, 6], "total": 12, "moreCount": 9, "coverage": "loaded" },
          { "id": "rail||RG1||leianokladi", "destination": "Leianokladi", "lineId": "RG1", "stopId": "GR_ATH", "nextMinutes": 55, "times": [55], "total": 1, "moreCount": 0, "coverage": "loaded" }
        ]
      }
    },
    {
      "id": "one_source_cannot_suppress_another_mode",
      "note": "Acceptance 4. A published railway response and projected metro data reach the board together. Reconciliation is per service, so neither mode is dropped and each row keeps its own source.",
      "input": {
        "windowMinutes": 720,
        "maxTimesPerGroup": 3,
        "departures": [
          { "stopId": "A3_ATH", "areaId": "rail", "lineId": "A3", "destination": "Chalkida", "tripId": "A3-1360", "time": "12:08", "absoluteMinutes": 8, "minutesAway": 8, "source": "scheduled", "sourceLabel": "Scheduled", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "M2-E-1", "time": "12:02", "absoluteMinutes": 2, "minutesAway": 2, "source": "estimated", "sourceLabel": "Estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Anthoupoli", "tripId": "M2-A-1", "time": "12:04", "absoluteMinutes": 4, "minutesAway": 4, "source": "estimated", "sourceLabel": "Estimated", "boardsHere": true }
        ],
        "coverage": []
      },
      "expect": {
        "partial": false,
        "timedGroupCount": 3,
        "groups": [
          { "id": "metro||M2||elliniko", "destination": "Elliniko", "lineId": "M2", "stopId": "M2_STA", "nextMinutes": 2, "times": [2], "total": 1, "source": "estimated", "coverage": "loaded" },
          { "id": "metro||M2||anthoupoli", "destination": "Anthoupoli", "lineId": "M2", "stopId": "M2_STA", "nextMinutes": 4, "times": [4], "total": 1, "source": "estimated", "coverage": "loaded" },
          { "id": "rail||A3||chalkida", "destination": "Chalkida", "lineId": "A3", "stopId": "A3_ATH", "nextMinutes": 8, "times": [8], "total": 1, "source": "scheduled", "coverage": "loaded" }
        ]
      }
    },
    {
      "id": "branch_destinations_stay_distinct",
      "note": "Acceptance 5. A branching route with three real headsigns produces three rows, not one two-valued direction.",
      "input": {
        "windowMinutes": 720,
        "maxTimesPerGroup": 3,
        "departures": [
          { "stopId": "M3_SYN", "areaId": "metro", "lineId": "M3", "destination": "Doukissis Plakentias", "patternKey": "city", "tripId": "M3-1", "time": "12:03", "absoluteMinutes": 3, "minutesAway": 3, "source": "estimated", "boardsHere": true },
          { "stopId": "M3_SYN", "areaId": "metro", "lineId": "M3", "destination": "Airport", "patternKey": "airport", "tripId": "M3-2", "time": "12:09", "absoluteMinutes": 9, "minutesAway": 9, "source": "estimated", "boardsHere": true },
          { "stopId": "M3_SYN", "areaId": "metro", "lineId": "M3", "destination": "Dimotiko Theatro", "patternKey": "city", "tripId": "M3-3", "time": "12:05", "absoluteMinutes": 5, "minutesAway": 5, "source": "estimated", "boardsHere": true }
