        ],
        "coverage": []
      },
      "expect": {
        "partial": false,
        "timedGroupCount": 3,
        "groups": [
          { "id": "rail||A1||airport", "destination": "Airport", "nextMinutes": 15, "times": [15], "total": 1, "source": "live", "coverage": "loaded" },
          { "id": "rail||A3||chalkida", "destination": "Chalkida", "nextMinutes": 20, "times": [20], "total": 1, "source": "scheduled", "coverage": "loaded" },
          { "id": "rail||A4||kiato", "destination": "Kiato", "nextMinutes": 20, "times": [20], "total": 1, "source": "scheduled", "coverage": "loaded" }
        ]
      }
    },
    {
      "id": "arrivals_and_non_pickup_stops_are_not_departures",
      "note": "Acceptance 8. A terminal arrival with no onward boarding never becomes an actionable departure, so the board cannot offer a train 'to this very station'.",
      "input": {
        "windowMinutes": 720,
        "maxTimesPerGroup": 3,
        "departures": [
          { "stopId": "GR_ATH", "areaId": "rail", "lineId": "IC1", "destination": "Athens", "tripId": "IC-55", "time": "12:05", "absoluteMinutes": 5, "minutesAway": 5, "source": "scheduled", "boardsHere": false },
          { "stopId": "GR_ATH", "areaId": "rail", "lineId": "IC1", "destination": "Thessaloniki", "tripId": "IC-54", "time": "12:25", "absoluteMinutes": 25, "minutesAway": 25, "source": "scheduled", "boardsHere": true }
        ],
        "coverage": []
      },
      "expect": {
        "partial": false,
        "timedGroupCount": 1,
        "groups": [
          { "id": "rail||IC1||thessaloniki", "destination": "Thessaloniki", "nextMinutes": 25, "times": [25], "total": 1, "coverage": "loaded" }
        ]
      }
    },
    {
      "id": "a_cancellation_is_status_never_the_recommendation",
      "note": "Acceptance 8. The cancelled train stays visible with its own cancelled flag, but the group's next departure is the following running train.",
      "input": {
        "windowMinutes": 720,
        "maxTimesPerGroup": 3,
        "departures": [
          { "stopId": "A3_ATH", "areaId": "rail", "lineId": "A3", "destination": "Chalkida", "tripId": "A3-1360", "time": "12:08", "absoluteMinutes": 8, "minutesAway": 8, "source": "scheduled", "cancelled": true, "status": "cancelled", "boardsHere": true },
