        ],
        "coverage": []
      },
      "expect": {
        "partial": false,
        "timedGroupCount": 1,
        "groups": [
          { "id": "rail||A3||chalkida", "destination": "Chalkida", "nextMinutes": 68, "times": [8, 68], "cancelledTimes": [true, false], "total": 2, "coverage": "loaded" }
        ]
      }
    },
    {
      "id": "partial_coverage_cannot_look_complete",
      "note": "Acceptance 9. One service failed to load. The board is flagged partial and the failed service renders as a differentiated status row after the timed results.",
      "input": {
        "windowMinutes": 720,
        "maxTimesPerGroup": 3,
        "departures": [
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "M2-E-1", "time": "12:02", "absoluteMinutes": 2, "minutesAway": 2, "source": "estimated", "boardsHere": true }
        ],
        "coverage": [
