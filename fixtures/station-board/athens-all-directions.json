{
  "name": "athens-all-directions",
  "description": "Language-neutral golden fixture for the station-complex all-directions board. Kotlin, Swift and JavaScript implementations must all reproduce `expect` exactly from `input`. Times are minutes from an explicit `now` on a monotonic timeline, so no implementation re-derives a service date or adds 24h to a past departure.",
  "complex": {
    "id": "CPX_ATHENS_LARISSA",
    "name": "Athens · Larissa Station",
    "nameEl": "Αθήνα · Σταθμός Λαρίσης",
    "nameSq": "Athinë · Stacioni Larisa",
    "nameIt": "Atene · Stazione Larissa",
    "areas": [
      { "id": "metro", "name": "Metro", "nameEl": "Μετρό", "nameSq": "Metro", "nameIt": "Metropolitana", "stopIds": ["M2_STA"] },
      { "id": "rail", "name": "Railway station", "nameEl": "Σιδηροδρομικός σταθμός", "nameSq": "Stacioni hekurudhor", "nameIt": "Stazione ferroviaria", "stopIds": ["A1_ATH", "A3_ATH", "A4_ATH", "GR_ATH"] }
    ]
  },
  "cases": [
    {
