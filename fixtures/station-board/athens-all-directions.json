          { "areaId": "rail", "stopId": "GR_ATH", "lineId": "IC1", "destination": "Thessaloniki", "state": "unavailable", "reason": "source_unreachable" }
        ]
      },
      "expect": {
        "partial": true,
        "timedGroupCount": 1,
        "groups": [
          { "id": "metro||M2||elliniko", "destination": "Elliniko", "nextMinutes": 2, "times": [2], "total": 1, "coverage": "loaded" },
          { "id": "rail||IC1||thessaloniki", "destination": "Thessaloniki", "times": [], "total": 0, "coverage": "unavailable" }
