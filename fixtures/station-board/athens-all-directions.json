          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "M2-E-2", "serviceDate": "2026-09-30", "time": "12:12", "absoluteMinutes": 12, "minutesAway": 12, "source": "estimated", "boardsHere": true },
