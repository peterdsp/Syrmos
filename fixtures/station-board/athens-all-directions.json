        "windowMinutes": 720,
        "maxTimesPerGroup": 3,
        "departures": [
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "F1", "time": "12:00", "absoluteMinutes": 0, "minutesAway": 0, "source": "estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "F2", "time": "12:03", "absoluteMinutes": 3, "minutesAway": 3, "source": "estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "F3", "time": "12:06", "absoluteMinutes": 6, "minutesAway": 6, "source": "estimated", "boardsHere": true },
          { "stopId": "M2_STA", "areaId": "metro", "lineId": "M2", "destination": "Elliniko", "tripId": "F4", "time": "12:09", "absoluteMinutes": 9, "minutesAway": 9, "source": "estimated", "boardsHere": true },
