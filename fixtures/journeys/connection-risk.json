      "option": { "legs": [
        { "id": "r0", "kind": "ride", "lineId": "M1", "fromId": "PIR", "toId": "OMO", "arrivalInstant": "2026-01-15T08:15:00+02:00" },
        { "id": "t1", "kind": "transfer", "fromId": "OMO", "toId": "OMO2", "transferMinimumSeconds": 120 },
        { "id": "r2", "kind": "ride", "lineId": "M2", "fromId": "OMO2", "toId": "SYN", "departureInstant": "2026-01-15T08:25:00+02:00", "arrivalInstant": "2026-01-15T08:35:00+02:00" },
        { "id": "t3", "kind": "transfer", "fromId": "SYN", "toId": "SYN3", "transferMinimumSeconds": 120 },
        { "id": "r4", "kind": "ride", "lineId": "M3", "fromId": "SYN3", "toId": "AIR", "departureInstant": "2026-01-15T08:36:00+02:00" }
      ] },
      "expectedRisks": [
