      "option": { "legs": [
        { "id": "r0", "kind": "ride", "lineId": "M2", "fromId": "SYN", "toId": "ELL", "departureInstant": "2026-01-15T08:00:00+02:00", "arrivalInstant": "2026-01-15T08:20:00+02:00" }
      ] },
