ops/syrmos-api/db/

# Ariadne on-device model (GGUF, ~470 MB) is fetched + verified by CI, never committed.
# See scripts/fetch-ariadne-model.sh and core/common/.../AriadneModelManifest.kt
*.gguf
iosApp/iosApp/Resources/model/

# fastlane auto-generated artifacts (keep Appfile, Fastfile, metadata/)
fastlane/report.xml
fastlane/README.md
fastlane/test_output

# Python bytecode from the ops/ API tests and scrapers.
__pycache__/
*.pyc
