{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AriadneIntent",
  "description": "Guided generation schema for Apple @Generable, Gemini Nano JSON output, or a generic structured classifier. The model emits this only, then the app validates slots and dispatches deterministic tools.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "showDepartures"
        },
        "stationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lineId": {
          "type": [
            "string",
            "null"
          ]
        },
        "dayContext": {
          "enum": [
            "today",
            "tomorrow",
            "weekend",
            "saturday",
            "sunday"
          ]
        }
      },
      "required": [
        "intent",
        "dayContext"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "lastTrain"
        },
        "stationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lineId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "findStation"
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "intent",
        "query"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "planTrip"
        },
        "fromStationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "toStationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lowExposure": {
          "type": "boolean"
        }
      },
      "required": [
        "intent",
        "lowExposure"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "travelTime"
        },
        "fromStationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "toStationId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "explainLine"
        },
        "lineId": {
          "type": "string"
        }
      },
      "required": [
        "intent",
        "lineId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "explainFare"
        },
