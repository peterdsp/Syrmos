        "fromStationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "toStationId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "intent",
        "airport"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "toggleFavorite"
        },
        "stationId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "showAlerts"
        },
        "lineId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "openMap"
        },
        "stationId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "help"
        }
      },
      "required": [
        "intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "weatherAt"
        },
        "stationId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "intent"
      ],
      "additionalProperties": false
