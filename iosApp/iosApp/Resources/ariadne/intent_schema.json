    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "planTripByArrival"
        },
        "fromStationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "toStationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "arriveByAthensMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1439
        },
        "inMinutesFromNow": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1440
        }
      },
      "required": [
        "intent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "outOfScope"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "intent",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "intent": {
          "const": "needsClarification"
        },
        "missing": {
          "enum": [
            "originStation",
            "destinationStation",
            "station"
          ]
        },
        "baseIntent": {
          "type": "string"
        }
      },
      "required": [
        "intent",
        "missing",
        "baseIntent"
      ],
      "additionalProperties": false
    }
  ],
  "requiredPolicy": "Every generated object must contain intent. The app must reject unknown stationId or lineId values and retry with station vocabulary or ask a clarification question.",
  "allowedLineIds": [
    "M1",
    "M2",
    "M3",
    "T6",
    "T7",
    "A1",
    "A2",
    "A3",
    "A4",
    "M3_AIR"
  ],
  "dayContextValues": [
    "today",
    "tomorrow",
    "weekend",
    "saturday",
    "sunday"
  ]
}
